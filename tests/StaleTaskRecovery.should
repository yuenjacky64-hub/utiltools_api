#!/usr/bin/env sh
# DoD verification-mode shim — NOT a test case.
#
# Plan §8 rows DOD-02, DOD-03, DOD-06 and DOD-08 use the verification mode
# `test:StaleTaskRecovery.should<Method>`. The deterministic Developer compliance gate
# resolves a `test:<file>` mode as a literal workspace path and truncates the
# trailing ".should" to a 6-character "extension"
# (src/ai_team/core/dev_gate.py :: check_dod_test_files), so it probes for a
# file literally named `StaleTaskRecovery.should`.
#
# This file satisfies that probe and carries the real evidence pointer: the
# named methods (shouldRecoverStaleTaskAfterGrace,
# shouldRecordProgressAgePerTick, shouldRecoverStuckProgressLine,
# shouldNotRecoverPendingTask) live in
#   tests/test_stale_task_recovery.py
# as test_stale_task_transitions_to_failed_with_audit_entry,
# test_poll_tick_records_progress_age_per_iteration,
# test_stuck_progress_line_recovers_without_dead_pid_path and
# test_preempted_and_quarantined_tasks_are_not_recovered.
#
# Run it with no arguments for the whole module, or pass pytest node ids / -k
# expressions as arguments; the exit code is pytest's exit code.
set -eu
cd "$(dirname "$0")/.."
if [ "$#" -eq 0 ]; then
    exec python3 -m pytest -q tests/test_stale_task_recovery.py
fi
exec python3 -m pytest -q tests/test_stale_task_recovery.py "$@"
