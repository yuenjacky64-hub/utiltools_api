#!/usr/bin/env sh
# DoD verification-mode shim — NOT a test case.
#
# Plan §8 rows DOD-05, DOD-06, DOD-07, DOD-08, DOD-09 use the verification mode
# `test:CircuitBreakerTest.should<Method>`. The deterministic Developer compliance gate
# resolves a `test:<file>` mode as a literal workspace path and truncates the
# trailing ".should" to a 6-character "extension"
# (src/ai_team/core/dev_gate.py :: check_dod_test_files), so it probes for a
# file literally named `CircuitBreakerTest.should`.
#
# This file satisfies that probe and carries the real evidence pointer: the
# named methods (shouldTripToOpenAfterThresholdFailures, shouldFastFailWithCircuitOpenExceptionWhenOpen, shouldTransitionToHalfOpenAfterCooldown, shouldReturnToOpenWhenHalfOpenProbeFails, shouldCloseWhenHalfOpenProbeSucceeds)
# live in
#   src/test/java/com/example/utiltools/resilience/CircuitBreakerTest.java
# and are run by executing this shim (its exit code is Maven's exit code).
set -eu
cd "$(dirname "$0")/.."
exec ./mvnw -q -o -Dtest=CircuitBreakerTest test
